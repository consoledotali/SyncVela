# ==============================================================================
# SyncVela Backend Configuration (.env.example)
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:5000
COOKIE_SAME_SITE=lax

# Database (PostgreSQL & Prisma)
DATABASE_URL=postgresql://postgres:rootpassword@localhost:5432/syncvela?schema=public
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
PRISMA_LOG_QUERIES=false

# Distributed Cache, Rate Limiting & Socket.IO Pub/Sub (Redis)
REDIS_URL=redis://127.0.0.1:6379

# Authentication & Security
JWT_SECRET=your-32-character-minimum-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-32-character-minimum-jwt-refresh-secret-key-change-in-production
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Email Service (Resend for OTP Verification & Invitations)
RESEND_API_KEY=re_your_resend_api_key_here

# Object Storage (AWS S3 / MinIO / DigitalOcean Spaces)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=syncvela_local_minio
OBJECT_STORAGE_SECRET_KEY=SyncVelaMinIO!2026Local
OBJECT_STORAGE_BUCKET=syncvela-attachments
OBJECT_STORAGE_PUBLIC_BUCKET=syncvela-avatars
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_USE_ACL=false

